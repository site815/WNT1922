* text=auto eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.mp3 binary
*.zip binary
*.ico binary
*.png binary
*.jpg binary
*.exr binary
*.glb binary
*.geojson binary
*.gz binary
# Raw signed-int16 elevation samples must never undergo newline conversion.
assets/terrain/elevation.bin binary
# Preserve the upstream compiler notice exactly, including its whitespace.
assets/licenses/NSIS-LICENSE.txt -text -whitespace
# Recognition source hashes cover the exact SVG bytes, including upstream line endings.
# Preserve imported vector files; their original trailing whitespace is not a code defect.
assets/recognition/**/*.svg -text whitespace=-blank-at-eol
# The glTFRuntime provenance manifest hashes upstream source bytes verbatim.
unreal/Plugins/glTFRuntime/** -text -whitespace
